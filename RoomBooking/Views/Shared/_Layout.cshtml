<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-info" >
        <div class="container" >
            @Html.ActionLink("🏨Room Booking System", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link navbar-brand meem" })</li>
                    <li>@Html.ActionLink("About", "About", "Home", new { area = "" }, new { @class = "nav-link navbar-brand meem" })</li>
                    <li>@Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link navbar-brand meem" })</li>
                    <li>@Html.ActionLink("Rooms", "Index", "Room", new { area = "" }, new { @class = "nav-link navbar-brand meem" })</li>
                    <li>@Html.ActionLink("Bookings", "Index", "Booking", new { area = "" }, new { @class = "nav-link navbar-brand meem" })</li>
                    @if (Session["UserId"] != null)
                    {
                       
                        <li style="font-weight:bolder">Hello, @Session["Username"]</li> 
                        <li>@Html.ActionLink("Logout", "Logout", "Account", new { area = "" }, new { @class = "nav-link navbar-brand meem" })</li>
                    }
                    

                </ul>
            </div>
        </div>
    </nav>

    @Scripts.Render("~/bundles/jquery")
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Mohshena AKter</p>
        </footer>
    </div>


    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
