@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="aspnetTitle">
        <h1 id="title">Hotel Booking System</h1>
        <p class="lead">Make it easy to book what you love!</p>
        <p><a href="https://asp.net" class="btn btn-primary btn-md">Learn more &raquo;</a></p>
    </section>

    <div class="row">
        <section class="col-md-4" aria-labelledby="gettingStartedTitle">
            <h2 id="gettingStartedTitle">Getting Started</h2>
            <p>
                Welcome to our Hotel Management System! Here you can easily check room availability, make reservations,
                view services, and manage your bookings all in one place. Our system is designed to make your hotel experience
                simple, fast, and convenient.
            </p>


            <p><a class="btn btn-outline-dark" href="https://go.microsoft.com/fwlink/?LinkId=301865">Learn more &raquo;</a></p>
        </section>
        <section class="col-md-4" aria-labelledby="librariesTitle">
            <h2 id="librariesTitle">Get more libraries</h2>
            <p>
                Explore the extra services we offer during your stay. From spa treatments to dining options,
                all services are available online for easy booking and payment. Everything is linked directly to your reservation
                for a seamless experience.
            </p>
            <p><a class="btn btn-outline-dark" href="https://go.microsoft.com/fwlink/?LinkId=301866">Learn more &raquo;</a></p>
        </section>
        <section class="col-md-4" aria-labelledby="hostingTitle">
            <h2 id="hostingTitle">Web Hosting</h2>
            <p>
                You can access the Hotel Management System anytime from your computer, tablet, or smartphone.
                Whether you’re checking your reservation, browsing rooms, or paying bills, everything is available online
                and secure.
            </p>
            <p><a class="btn btn-outline-dark" href="https://go.microsoft.com/fwlink/?LinkId=301867">Learn more &raquo;</a></p>
        </section>
    </div>
</main>