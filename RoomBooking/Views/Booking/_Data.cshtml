@model RoomBooking.ViewModel.BookingVM

<div>
    <hr />
    <table class="table table-responsive">
        <thead>
            <tr>
                <th>RoomType</th>
                <th>PricePerNight</th>
                <th>CheckIn</th>
                <th>CheckOut</th>
                <th>
                    <button id="add-detail-btn" type="button" name="operation" value="add" class="btn-link details">Add</button>
                </th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.BookingDetails.Count; i++)
            {
                <tr>
                    <td>
                        @Html.DropDownListFor(model => model.BookingDetails[i].RoomId,
                           new SelectList(ViewBag.Rooms as IEnumerable<SelectListItem>, "Value", "Text", Model.BookingDetails[i].RoomId),
                            "-- Select Room --",
                            new { @class = "form-control room-dropdown", data_index = i })
                    </td>
                    <td>
                        @Html.TextBoxFor(a => Model.BookingDetails[i].PricePerNight, new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        })
                    </td>
                    <td>
                        @Html.TextBoxFor(a => Model.BookingDetails[i].CheckInDate, new
                        {
                           @class = "form-control",
                           type = "date",
                           Value = Model.BookingDetails[i].CheckInDate != DateTime.MinValue
                             ? Model.BookingDetails[i].CheckInDate.ToString("yyyy-MM-dd")
                             : string.Empty
                        })
                    </td>
                    <td>
                        @Html.TextBoxFor(a => Model.BookingDetails[i].CheckOutDate, new
                        {
                            @class = "form-control",
                            type = "date",
                            Value = Model.BookingDetails[i].CheckOutDate != DateTime.MinValue
                             ? Model.BookingDetails[i].CheckOutDate.ToString("yyyy-MM-dd")
                             : string.Empty
                        })
                    </td>
                    <td>
                        <button type="button" name="operation" value="delete-@i" class="btn-link delete">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>